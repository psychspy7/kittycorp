{
  "name": "kitty-corp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:next": "next dev --port 3000",
    "build:next": "next build",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "test:performance": "node scripts/test-performance.mjs",
    "test:load": "node scripts/load-test-website.mjs",
    "check:website": "node scripts/check-website.mjs",
    "check:hosting": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-hosting.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
