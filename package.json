    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "razorpay": "2.9.8",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
