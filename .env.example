# Server-only configuration. Copy to .env.local; never commit .env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ADMIN_EMAIL=your-supabase-admin-email
ADMIN_USER_ID=your-supabase-admin-user-uuid
FEEDBACK_GATEWAY_TOKEN=generate-a-random-64-character-hex-token
SITE_URL=https://your-website.example
# Optional public GA4 measurement ID override; blank uses the Kitty Corp stream.
# Set to disabled to switch off analytics for a deployment.
GOOGLE_ANALYTICS_ID=

# Optional private overrides for the encrypted integration configuration.
# The current production installation already has these securely provisioned.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave blank to enable automatically when a real widget is configured.
TURNSTILE_ENABLED=
KITTY_AI_WEBSITE_URL=https://kitty-ai-v2.kitty-ai.workers.dev/api/website/chat
KITTY_AI_GATEWAY_TOKEN=
# Local preview only. Never enable this on a hosted deployment.
KITTY_LOCAL_PREVIEW=false

# Razorpay Standard Checkout. Secret is server-only; never add NEXT_PUBLIC_ to it.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
# Fixed server-controlled payment amount in paise. 100 = INR 1.00.
# This is a test checkout, not an invoice/product catalogue.
RAZORPAY_CHECKOUT_AMOUNT_PAISE=100

# Gmail app password for kittycorp.info@gmail.com, never the account password.
# Leave blank until ready. Never use a NEXT_PUBLIC_ prefix.
GMAIL_APP_PASSWORD=

# Optional server-only payment-provider overrides. Studio can save these encrypted.
# Provider modes and approved status are configured in Studio; default is OFF.
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Never rotate FEEDBACK_GATEWAY_TOKEN without migrating encrypted runtime settings.

# Product memberships: private server bridge, distinct from service/donation payments.
KITTY_MEMBERSHIP_BACKEND=https://kitty-ai-v2.kitty-ai.workers.dev
KITTY_COMMERCE_GATEWAY_TOKEN=
# Only for an isolated local backend preview; never on hosted environments.
MEMBERSHIP_LOCAL_PREVIEW=
