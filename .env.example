# Server-only configuration. Copy to .env.local; never commit .env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ADMIN_LOGIN_ID=your-admin-id
ADMIN_EMAIL=your-supabase-admin-email
ADMIN_USER_ID=your-supabase-admin-user-uuid
FEEDBACK_GATEWAY_TOKEN=generate-a-random-64-character-hex-token
SITE_URL=https://your-website.example
# Optional public GA4 measurement ID override; blank uses the Kitty Corp stream.
# Set to disabled to switch off analytics for a deployment.
GOOGLE_ANALYTICS_ID=

# Optional private overrides for the encrypted integration configuration.
# The current production installation already has these securely provisioned.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave blank to enable automatically when a real widget is configured.
TURNSTILE_ENABLED=
KITTY_AI_WEBSITE_URL=https://kitty-ai-v2.kitty-ai.workers.dev/api/website/chat
KITTY_AI_GATEWAY_TOKEN=
# Local preview only. Never enable this on a hosted deployment.
KITTY_LOCAL_PREVIEW=false
